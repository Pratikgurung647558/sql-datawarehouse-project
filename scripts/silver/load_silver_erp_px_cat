-- PROCEDURE: silver.load_silver_erp_px_cat_g1v2()

-- DROP PROCEDURE IF EXISTS silver.load_silver_erp_px_cat_g1v2();

CREATE OR REPLACE PROCEDURE silver.load_silver_erp_px_cat_g1v2(
	)
LANGUAGE 'plpgsql'
AS $BODY$
BEGIN
    TRUNCATE TABLE silver.erp_px_cat_g1v2;
    
    INSERT INTO silver.erp_px_cat_g1v2
    (id, cat, subcat, maintenance)
    SELECT
        id,
        cat,
        subcat,
        maintenance
    FROM bronze.erp_px_cat_g1v2;
END;
$BODY$;
ALTER PROCEDURE silver.load_silver_erp_px_cat_g1v2()
    OWNER TO postgres;

