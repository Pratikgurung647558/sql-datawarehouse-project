-- PROCEDURE: silver.load_silver_erp_cust_az12()

-- DROP PROCEDURE IF EXISTS silver.load_silver_erp_cust_az12();

CREATE OR REPLACE PROCEDURE silver.load_silver_erp_cust_az12(
	)
LANGUAGE 'plpgsql'
AS $BODY$
BEGIN
    -- Clear existing data
    TRUNCATE TABLE silver.erp_cust_az12;

    -- Load transformed data from bronze
    INSERT INTO silver.erp_cust_az12(cid, bdate, gen)
    SELECT
        CASE 
            WHEN cid LIKE 'NAS%' THEN SUBSTRING(cid, 4, LENGTH(cid))
            ELSE cid
        END AS cid,
        CASE 
            WHEN bdate > CURRENT_DATE THEN NULL
            ELSE bdate
        END AS bdate,
        CASE 
            WHEN UPPER(TRIM(gen)) IN ('F', 'FEMALE') THEN 'Female'
            WHEN UPPER(TRIM(gen)) IN ('M', 'MALE') THEN 'Male'
            ELSE 'n/a'
        END AS gen
    FROM bronze.erp_cust_az12;
END;
$BODY$;
ALTER PROCEDURE silver.load_silver_erp_cust_az12()
    OWNER TO postgres;

